{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Axios Cleaner",
  "version": "1.2.4",
  "identifier": "dev.axios.cleaner",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Axios Cleaner",
        "width": 1120,
        "height": 740,
        "minWidth": 940,
        "minHeight": 640,
        "decorations": false,
        "transparent": false,
        "theme": "Dark",
        "backgroundColor": "#0C0C0F",
        "center": true,
        "label": "main",
        "create": false,
        "additionalBrowserArgs": "--disable-features=msOneAuthWAM,msLoadOneAuthInBackground,msImplicitSignin,msWebOOUI,msPdfOOUI,msSmartScreenProtection,msEdgeConfigService,msExperimentationService,OptimizationHints,Translate,MediaRouter,AutofillServerCommunication,InterestFeedContentSuggestions,CertificateTransparencyComponentUpdater --disable-background-networking --disable-component-update --disable-domain-reliability --disable-client-side-phishing-detection --disable-sync --disable-breakpad --metrics-recording-only --safebrowsing-disable-auto-update --no-pings --no-first-run --no-default-browser-check --host-resolver-rules=\"MAP * ~NOTFOUND , EXCLUDE tauri.localhost , EXCLUDE ipc.localhost\" --proxy-server=127.0.0.1:9 --proxy-bypass-list=tauri.localhost;ipc.localhost"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "PortugueseBR"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwNEZCMDI2MDNFMTZFOUUKUldTZWJ1RURKckJQSU84ODhXc3JpcTdONFhLcGtMSnBBUlRRbncxdUZvL3IzNno4WjBDd09qckoK",
      "endpoints": [
        "https://github.com/YuriTals/axios-cleaner/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
